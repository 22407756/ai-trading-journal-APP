rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for user's logged trades
      match /trades/{tradeId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection for user's subscription payments and receipts
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId) || (isAuthenticated() && request.auth.token.email == 'saraoussoussou2006@gmail.com');
      }

      // User's private FCM push notification tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // User's private alerts history
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Historical market signals preserved for quantitative backtesting
    match /signals/{signalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
